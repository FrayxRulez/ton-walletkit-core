<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 so UWP / .NET Native can consume it (same target the
         generated API models used). -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Ton.WalletKit</RootNamespace>
    <AssemblyName>Ton.WalletKit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>C# binding for ton-walletkit-core (twk.dll).</Description>
  </PropertyGroup>

  <!-- The SDK already globs src\**\*.cs; an explicit Include would duplicate it.
       test\ holds the dev-only harness, which is its own executable project. -->
  <ItemGroup>
    <Compile Remove="test\**" />
    <None Remove="test\**" />
  </ItemGroup>


  <!-- netstandard2.0 lacks these; the generated models need them.
       System.Text.Json     - the generated converters (generichost emits
                              hand-written converters, so no reflection at runtime,
                              which is what .NET Native requires).
       ComponentModel.Annotations - IValidatableObject / ValidationResult.
       PolySharp            - nullable/interop attributes the generator emits. -->
  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
